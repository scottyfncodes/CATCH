# Client (Vite): WebSocket URL of the room server. Defaults to ws://<host>:8787/ws in development.
VITE_SERVER_URL=wss://catch-server.onrender.com/ws

# Server: comma-separated allowed browser origins ("*.vercel.app" style wildcards OK). Empty = allow all.
ALLOWED_ORIGINS=
# Server: optional directory to persist group records as JSON (needs a persistent disk).
DATA_DIR=
PORT=8787
